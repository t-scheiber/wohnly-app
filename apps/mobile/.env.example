# Copy to `.env` and fill in for local dev builds (Expo loads EXPO_PUBLIC_* at bundling time).
#
# RevenueCat public SDK keys (Project settings → API keys → app-specific).
# Required for in-app purchases on native; entitlement identifier in app: "Wohnly Pro".
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Optional: RevenueCat offering identifier if not using the dashboard "current" offering (e.g. "default").
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=

# Store product IDs (must match RevenueCat + App Store Connect / Play Console exactly).
# Dashboard product: "Wohnly Pro Lifetime" → wohnly_pro_lifetime
EXPO_PUBLIC_REVENUECAT_IOS_PRODUCT_ID=wohnly_pro_lifetime
EXPO_PUBLIC_REVENUECAT_ANDROID_PRODUCT_ID=wohnly_pro_lifetime

# Set to "true" to show paywall preview UI when IAP is not ready (App Store review screenshot).
EXPO_PUBLIC_PAYWALL_PREVIEW=true
