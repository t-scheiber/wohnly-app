{
  "expo": {
    "name": "Wohnly",
    "slug": "wohnly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wohnly",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.wohnly",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Wohnly needs calendar access to sync your household events.",
        "NSCalendarsFullAccessUsageDescription": "Wohnly needs calendar access to sync your household events."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6db5a8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "app.wohnly",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#6db5a8",
          "dark": {
            "backgroundColor": "#0f172a"
          }
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9b2a55c7-f196-44f8-a50d-232f25c5f8b5"
      },
      "apiUrl": "https://api.wohnly.app"
    },
    "owner": "toxi9"
  }
}
