{
  "expo": {
    "name": "Wohnly",
    "slug": "wohnly",
    "version": "1.3.3",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "wohnly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.wohnly",
      "usesAppleSignIn": true,
      "appleTeamId": "8RSPLFN63L",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Wohnly needs calendar access to sync your household events.",
        "NSCalendarsFullAccessUsageDescription": "Wohnly needs calendar access to sync your household events.",
        "NSCameraUsageDescription": "Wohnly uses the camera to scan receipts and attach photos to expenses, so you can keep a visual record of your household spending.",
        "NSPhotoLibraryUsageDescription": "Wohnly accesses your photo library to let you attach existing receipt photos or images to expenses for record-keeping.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiredDeviceCapabilities": []
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.app.wohnly"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6db5a8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "app.wohnly",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["@bacons/apple-targets"],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#6db5a8",
          "dark": {
            "backgroundColor": "#0f172a"
          }
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "WohnlyTodos",
              "label": "Wohnly Todos",
              "description": "Your pending household tasks",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "WohnlyCalendar",
              "label": "Wohnly Calendar",
              "description": "Today's household events",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "updatePeriodMillis": 900000
            },
            {
              "name": "WohnlyShoppingList",
              "label": "Wohnly Shopping List",
              "description": "Your household shopping list",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "updatePeriodMillis": 900000
            }
          ],
          "widgetTaskHandlerPath": "lib/widgets/android/widget-task-handler"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9336334259937355~5526321352",
          "iosAppId": "ca-app-pub-9336334259937355~3678887210"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1f4ce882-1b70-4606-8b77-48c02e3d523e"
      },
      "apiUrl": "https://api.wohnly.app"
    },
    "owner": "toxi9"
  }
}
