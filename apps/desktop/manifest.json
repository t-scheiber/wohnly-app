{
  "id": "app.wohnly",
  "name": "Wohnly - Household Manager",
  "short_name": "Wohnly",
  "description": "Manage shared expenses, chores, events & shopping lists with your household.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#faf8f5",
  "theme_color": "#6db5a8",
  "orientation": "any",
  "dir": "ltr",
  "lang": "en",
  "categories": ["lifestyle", "productivity"],
  "iarc_rating_id": "",
  "scope_extensions": [
    { "origin": "https://api.wohnly.app" }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Home",
      "url": "/",
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Add Expense",
      "short_name": "Expense",
      "url": "/(app)/(finances)",
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Shopping List",
      "short_name": "Shopping",
      "url": "/(app)/(lists)/shopping",
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Chores",
      "short_name": "Chores",
      "url": "/(app)/(chores)",
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96" }]
    }
  ],
  "file_handlers": [],
  "protocol_handlers": [
    {
      "protocol": "web+wohnly",
      "url": "/?action=%s"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "widgets": [
    {
      "name": "Wohnly Chores",
      "description": "View today's chores at a glance",
      "tag": "chores",
      "ms_ac_template": "widget/chores",
      "screenshots": [],
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Wohnly Todos",
      "description": "View your to-do list at a glance",
      "tag": "todos",
      "ms_ac_template": "widget/todos",
      "screenshots": [],
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96" }]
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "icons": [
    {
      "src": "/icons/icon-44.png",
      "sizes": "44x44",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-48.png",
      "sizes": "48x48",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-72.png",
      "sizes": "72x72",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-96.png",
      "sizes": "96x96",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-128.png",
      "sizes": "128x128",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-256.png",
      "sizes": "256x256",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "id": "app.wohnly"
    },
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/app/id6761035211"
    }
  ]
}
