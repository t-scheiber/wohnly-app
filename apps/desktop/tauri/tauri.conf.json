{
  "$schema": "https://raw.githubusercontent.com/nicedoc/nice-lsp/master/schemas/tauri.schema.json",
  "productName": "Wohnly",
  "version": "1.3.3",
  "identifier": "app.wohnly",
  "build": {
    "frontendDist": "../../mobile/dist",
    "devUrl": "http://localhost:8081"
  },
  "app": {
    "windows": [
      {
        "title": "Wohnly",
        "width": 1024,
        "height": 768,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["wohnly"]
      }
    },
    "shell": {
      "open": "^https?://.+"
    },
    "updater": {
      "endpoints": [
        "https://github.com/t-scheiber/wohnly-app/releases/download/desktop-latest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhENkJBMUI4Njc1RjI4NTQKUldSVUtGOW51S0ZyalVCVXR0aDJNU0pjRFJpMnJ6WTJhdnpjcmloZjdlMnRHRW5sTUV2RC80UGMK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "category": "Lifestyle",
    "publisher": "Wohnly",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis-hooks.nsi"
      }
    }
  }
}
