{
  "$schema": "https://raw.githubusercontent.com/nicedoc/nice-lsp/master/schemas/tauri.schema.json",
  "productName": "Wohnly",
  "version": "1.0.0",
  "identifier": "app.wohnly.desktop",
  "build": {
    "frontendDist": "../../mobile/dist",
    "devUrl": "http://localhost:8081"
  },
  "app": {
    "title": "Wohnly",
    "windows": [
      {
        "title": "Wohnly",
        "width": 1024,
        "height": 768,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.wohnly.app https://*.revenuecat.com; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
