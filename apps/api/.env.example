# Server
PORT=3001
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=change-this-to-a-random-32-char-string

# Database
DATABASE_URL=postgresql://wohnly:your-secure-password@localhost:5432/wohnly

# OAuth (optional for dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Email (optional for dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@wohnly.app

# Payments (optional)
REVENUECAT_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Server-side encryption key (base64, 32 bytes)
ENCRYPTION_KEY=
